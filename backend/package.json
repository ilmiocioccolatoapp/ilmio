{
  "name": "il-mio-cioccolato-backend",
  "version": "1.0.0",
  "description": "Backend API for Il Mio Cioccolato cafe",
  "main": "server.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:baseline": "prisma migrate resolve --applied 202610300001_baseline",
    "test:integration": "node scripts/test-integration.js",
    "admin:invite-platform": "node scripts/invite-platform-admin.js",
    "admin:bootstrap-ilmio": "node scripts/bootstrap-ilmio-brand-admin.js",
    "store:init-ilmio": "node scripts/initialize-ilmio-store.js",
    "brands:reconcile-duplicates": "node scripts/reconcile-duplicate-brands.js",
    "db:backup": "node scripts/database-ops.js backup",
    "db:restore-check": "node scripts/database-ops.js restore-check",
    "legacy:adoption-report": "node scripts/legacy-adoption-report.js"
  },
  "keywords": [
    "cafe",
    "api",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.118.0",
    "argon2": "0.45.1",
    "cloudinary": "2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "9.0.3",
    "prisma": "6.19.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prettier": "3.6.2"
  }
}
