PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/ilmiocioccolato
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
STORE_JWT_SECRET=replace-with-at-least-32-random-characters
# Point to the React app route that lets invitees set their own password.
ADMIN_INVITE_REDIRECT_URL=http://localhost:3000/set-password
# Used once to bootstrap the first confirmed Platform Admin, then remove it.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=platform-admin@example.com
# Comma-separated exact browser origins, without trailing slashes.
ADMIN_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY_HOPS=0
