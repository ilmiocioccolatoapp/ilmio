generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  dbId      String    @id @default(cuid())
  id        String    @unique
  name      String
  icon      String    @default("📦")
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([order])
}

model Product {
  dbId          String   @id @default(cuid())
  title         String
  category      String
  image         String
  imagePublicId String?
  description   String
  ingredients   String
  price         String
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  categoryRef   Category @relation(fields: [category], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([category])
  @@index([available])
}
